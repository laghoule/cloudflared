{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloudflared Helm chart values",
  "description": "Validation schema for the cloudflared Helm chart values.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "goDuration": {
      "type": "string",
      "description": "Go duration, for example 30s, 1m30s, or 0.",
      "pattern": "^$|^0$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "prometheusDuration": {
      "type": "string",
      "description": "Prometheus duration, for example 30s, 5m, or 1h.",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h|d|w|y))+$"
    },
    "percentageOrInteger": {
      "description": "An integer or a percentage string such as 25%.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+%$"
        }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number",
            "minimum": 0
          }
        ]
      }
    },
    "seccompProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RuntimeDefault",
            "Localhost",
            "Unconfined"
          ]
        },
        "localhostProfile": {
          "type": "string"
        }
      }
    },
    "envVar": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "valueFrom": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "volumeMount": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "mountPath"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "readOnly": {
          "type": "boolean"
        },
        "subPath": {
          "type": "string"
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "expr"
      ],
      "anyOf": [
        {
          "required": [
            "alert"
          ]
        },
        {
          "required": [
            "record"
          ]
        }
      ],
      "properties": {
        "alert": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "for": {
          "$ref": "#/definitions/prometheusDuration"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved for Helm global values."
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25,
      "description": "Number of cloudflared replicas. Cloudflare supports up to 25 replicas per tunnel. Set to 0 to scale the connector down without uninstalling the release."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "name": {
          "type": "string",
          "maxLength": 63
        }
      }
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroupChangePolicy": {
          "type": "string",
          "enum": [
            "OnRootMismatch",
            "Always"
          ]
        },
        "seccompProfile": {
          "$ref": "#/definitions/seccompProfile"
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "privileged": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "procMount": {
          "type": "string",
          "enum": [
            "Default",
            "Unmasked"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "seccompProfile": {
          "$ref": "#/definitions/seccompProfile"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "$ref": "#/definitions/percentageOrInteger"
            },
            "maxSurge": {
              "$ref": "#/definitions/percentageOrInteger"
            }
          }
        }
      }
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "",
        "auto",
        "http2",
        "quic"
      ]
    },
    "gracePeriod": {
      "$ref": "#/definitions/goDuration"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/envVar"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/volume"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/volumeMount"
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[-._a-zA-Z0-9]+$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "tunnelID": {
          "type": "string"
        },
        "configFile": {
          "type": "string"
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "service"
            ],
            "properties": {
              "hostname": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "originRequest": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "extraConfig": {
          "type": "object",
          "additionalProperties": true
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer",
                "ExternalName"
              ]
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "$ref": "#/definitions/prometheusDuration"
            },
            "scrapeTimeout": {
              "$ref": "#/definitions/prometheusDuration"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/prometheusRule"
              }
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dashboards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "labelValue": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^([0-9]+|[0-9]+%)$"
            }
          ]
        }
      }
    }
  }
}
